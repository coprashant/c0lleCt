    "configurations": [
        {
            "name": "Debug SFML Game",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/cmake-build-debug/c0lleCt.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/cmake-build-debug",
